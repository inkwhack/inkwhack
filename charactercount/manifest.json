        {
          "language": "html",
          "content": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>Character Counter</title>\n<style>\n  * { box-sizing: border-box; margin: 0; padding: 0; }\n\n  body {\n    font-family: -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, sans-serif;\n    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);\n    min-height: 100vh;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    padding: 20px;\n  }\n\n  .container {\n    background: #fff;\n    border-radius: 16px;\n    box-shadow: 0 20px 60px rgba(0,0,0,0.3);\n    width: 100%;\n    max-width: 700px;\n    padding: 32px;\n  }\n\n  h1 {\n    font-size: 24px;\n    color: #2d3748;\n    margin-bottom: 20px;\n    display: flex;\n    align-items: center;\n    gap: 10px;\n  }\n\n  h1::before {\n    content: \"\u270d\ufe0f\";\n    font-size: 26px;\n  }\n\n  textarea {\n    width: 100%;\n    min-height: 200px;\n    padding: 16px;\n    font-size: 16px;\n    font-family: inherit;\n    line-height: 1.6;\n    border: 2px solid #e2e8f0;\n    border-radius: 12px;\n    resize: vertical;\n    outline: none;\n    transition: border-color 0.2s, box-shadow 0.2s;\n  }\n\n  textarea:focus {\n    border-color: #667eea;\n    box-shadow: 0 0 0 4px rgba(102,126,234,0.15);\n  }\n\n  .stats {\n    display: grid;\n    grid-template-columns: repeat(auto-fit, minmax(120px, 1fr));\n    gap: 12px;\n    margin-top: 20px;\n  }\n\n  .stat {\n    background: #f7fafc;\n    border-radius: 12px;\n    padding: 14px;\n    text-align: center;\n    border: 1px solid #edf2f7;\n    transition: transform 0.15s, background 0.2s;\n  }\n\n  .stat:hover {\n    transform: translateY(-2px);\n    background: #edf2f7;\n  }\n\n  .stat .value {\n    font-size: 26px;\n    font-weight: 700;\n    color: #667eea;\n    display: block;\n    line-height: 1.2;\n  }\n\n  .stat .label {\n    font-size: 12px;\n    color: #718096;\n    text-transform: uppercase;\n    letter-spacing: 0.5px;\n    margin-top: 4px;\n    font-weight: 600;\n  }\n\n  .actions {\n    display: flex;\n    gap: 10px;\n    margin-top: 20px;\n    flex-wrap: wrap;\n  }\n\n  button {\n    flex: 1;\n    min-width: 120px;\n    padding: 12px 20px;\n    font-size: 14px;\n    font-weight: 600;\n    border: none;\n    border-radius: 10px;\n    cursor: pointer;\n    transition: background 0.2s, transform 0.1s;\n    font-family: inherit;\n  }\n\n  button:active { transform: scale(0.97); }\n\n  .btn-clear {\n    background: #fed7d7;\n    color: #c53030;\n  }\n  .btn-clear:hover { background: #feb2b2; }\n\n  .btn-copy {\n    background: #667eea;\n    color: #fff;\n  }\n  .btn-copy:hover { background: #5a67d8; }\n\n  .limit-row {\n    display: flex;\n    align-items: center;\n    gap: 10px;\n    margin-top: 16px;\n    font-size: 14px;\n    color: #4a5568;\n  }\n\n  .limit-row input {\n    width: 90px;\n    padding: 8px 10px;\n    border: 2px solid #e2e8f0;\n    border-radius: 8px;\n    font-size: 14px;\n    outline: none;\n    font-family: inherit;\n  }\n\n  .limit-row input:focus { border-color: #667eea; }\n\n  .over-limit { color: #e53e3e !important; }\n  .warning { color: #dd6b20 !important; }\n\n  .toast {\n    position: fixed;\n    bottom: 30px;\n    left: 50%;\n    transform: translateX(-50%) translateY(100px);\n    background: #2d3748;\n    color: #fff;\n    padding: 12px 24px;\n    border-radius: 8px;\n    font-size: 14px;\n    opacity: 0;\n    transition: all 0.3s;\n    pointer-events: none;\n  }\n\n  .toast.show {\n    transform: translateX(-50%) translateY(0);\n    opacity: 1;\n  }\n</style>\n</head>\n<body>\n\n<div class=\"container\">\n  <h1>Character Counter</h1>\n\n  <textarea id=\"input\" placeholder=\"Type or paste your text here...\"></textarea>\n\n  <div class=\"limit-row\">\n    <label for=\"limit\">Character limit:</label>\n    <input type=\"number\" id=\"limit\" min=\"1\" placeholder=\"none\">\n    <span id=\"limitStatus\"></span>\n  </div>\n\n  <div class=\"stats\">\n    <div class=\"stat\">\n      <span class=\"value\" id=\"chars\">0</span>\n      <span class=\"label\">Characters</span>\n    </div>\n    <div class=\"stat\">\n      <span class=\"value\" id=\"charsNoSpace\">0</span>\n      <span class=\"label\">No Spaces</span>\n    </div>\n    <div class=\"stat\">\n      <span class=\"value\" id=\"words\">0</span>\n      <span class=\"label\">Words</span>\n    </div>\n    <div class=\"stat\">\n      <span class=\"value\" id=\"sentences\">0</span>\n      <span class=\"label\">Sentences</span>\n    </div>\n    <div class=\"stat\">\n      <span class=\"value\" id=\"paragraphs\">0</span>\n      <span class=\"label\">Paragraphs</span>\n    </div>\n    <div class=\"stat\">\n      <span class=\"value\" id=\"lines\">0</span>\n      <span class=\"label\">Lines</span>\n    </div>\n    <div class=\"stat\">\n      <span class=\"value\" id=\"readingTime\">0s</span>\n      <span class=\"label\">Read Time</span>\n    </div>\n  </div>\n\n  <div class=\"actions\">\n    <button class=\"btn-copy\" id=\"copyBtn\">\ud83d\udccb Copy Text</button>\n    <button class=\"btn-clear\" id=\"clearBtn\">\ud83d\uddd1\ufe0f Clear</button>\n  </div>\n</div>\n\n<div class=\"toast\" id=\"toast\"></div>\n\n<script>\n  const input = document.getElementById('input');\n  const limitInput = document.getElementById('limit');\n  const limitStatus = document.getElementById('limitStatus');\n\n  const els = {\n    chars: document.getElementById('chars'),\n    charsNoSpace: document.getElementById('charsNoSpace'),\n    words: document.getElementById('words'),\n    sentences: document.getElementById('sentences'),\n    paragraphs: document.getElementById('paragraphs'),\n    lines: document.getElementById('lines'),\n    readingTime: document.getElementById('readingTime'),\n    charsStat: document.getElementById('chars').parentElement\n  };\n\n  function updateStats() {\n    const text = input.value;\n\n    // Characters (including spaces)\n    const charCount = text.length;\n\n    // Characters (excluding whitespace)\n    const charNoSpace = text.replace(/\\s/g, '').length;\n\n    // Words: sequences of non-whitespace characters\n    const wordCount = text.trim() === ''\n      ? 0\n      : text.trim().split(/\\s+/).length;\n\n    // Sentences: split on . ! ? followed by space/end\n    const sentenceCount = text.trim() === ''\n      ? 0\n      : (text.match(/[^.!?]*[.!?]+(\\s|$)/g) || []).filter(s => s.trim()).length;\n\n    // Paragraphs: blocks separated by blank lines\n    const paragraphCount = text.trim() === ''\n      ? 0\n      : text.trim().split(/\\n\\s*\\n/).filter(p => p.trim()).length;\n\n    // Lines\n    const lineCount = text === '' ? 0 : text.split('\\n').length;\n\n    // Reading time (avg 200 words/min)\n    const minutes = wordCount / 200;\n    let readTime;\n    if (wordCount === 0) readTime = '0s';\n    else if (minutes < 1) readTime = Math.ceil(minutes * 60) + 's';\n    else readTime = minutes.toFixed(1) + 'm';\n\n    els.chars.textContent = charCount;\n    els.charsNoSpace.textContent = charNoSpace;\n    els.words.textContent = wordCount;\n    els.sentences.textContent = sentenceCount;\n    els.paragraphs.textContent = paragraphCount;\n    els.lines.textContent = lineCount;\n    els.readingTime.textContent = readTime;\n\n    // Character limit feedback\n    const limit = parseInt(limitInput.value, 10);\n    if (!isNaN(limit) && limit > 0) {\n      const remaining = limit - charCount;\n      if (remaining < 0) {\n        els.chars.classList.add('over-limit');\n        limitStatus.textContent = `${Math.abs(remaining)} over limit`;\n        limitStatus.className = 'over-limit';\n      } else if (remaining <= limit * 0.1) {\n        els.chars.classList.remove('over-limit');\n        limitStatus.textContent = `${remaining} remaining`;\n        limitStatus.className = 'warning';\n      } else {\n        els.chars.classList.remove('over-limit');\n        limitStatus.textContent = `${remaining} remaining`;\n        limitStatus.className = '';\n      }\n    } else {\n      els.chars.classList.remove('over-limit');\n      limitStatus.textContent = '';\n    }\n  }\n\n  // Toast helper\n  let toastTimer;\n  function showToast(msg) {\n    const toast = document.getElementById('toast');\n    toast.textContent = msg;\n    toast.classList.add('show');\n    clearTimeout(toastTimer);\n    toastTimer = setTimeout(() => toast.classList.remove('show'), 1800);\n  }\n\n  // Copy\n  document.getElementById('copyBtn').addEventListener('click', async () => {\n    if (!input.value) { showToast('Nothing to copy'); return; }\n    try {\n      await navigator.clipboard.writeText(input.value);\n      showToast('Copied to clipboard!');\n    } catch {\n      input.select();\n      document.execCommand('copy');\n      showToast('Copied to clipboard!');\n    }\n  });\n\n  // Clear\n  document.getElementById('clearBtn').addEventListener('click', () => {\n    input.value = '';\n    updateStats();\n    input.focus();\n  });\n\n  // Events\n  input.addEventListener('input', updateStats);\n  limitInput.addEventListener('input', updateStats);\n\n  // Init\n  updateStats();\n</script>\n\n</body>\n</html>"
        }
